package com.task.category.controller;

import com.fasterxml.jackson.databind.ObjectMapper;
import com.task.category.entity.Category;
import com.task.category.entity.Notification;
import com.task.category.service.CategoryService;
import com.task.category.service.NotificationService;

import org.junit.jupiter.api.Test;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.test.context.bean.override.mockito.MockitoBean;
import org.springframework.test.web.servlet.MockMvc;

import java.util.List;

import static org.mockito.Mockito.*;
import static org.springframework.test.web.servlet.request.MockMvcRequestBuilders.*;
import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.*;

@WebMvcTest({CategoryController.class, NotificationController.class})
@AutoConfigureMockMvc(addFilters = false)
class ControllerTest {

    @Autowired
    private MockMvc mockMvc;

    @MockitoBean
    private CategoryService categoryService;

    @MockitoBean
    private NotificationService notificationService;

    @Autowired
    private ObjectMapper objectMapper;

    // =====================================================
    // 🔹 CATEGORY CONTROLLER TESTS
    // =====================================================

    @Test
    void testCreateCategory() throws Exception {
        Category cat = new Category();
        cat.setCategoryId(1);
        cat.setCategoryName("Dev");

        when(categoryService.createCategory(any(Category.class))).thenReturn(cat);

        mockMvc.perform(post("/api/categories/create")
                .contentType("application/json")
                .content(objectMapper.writeValueAsString(cat)))
                .andExpect(status().isOk())
                .andExpect(jsonPath("$.categoryName").value("Dev"));
    }

    @Test
    void testGetAllCategories() throws Exception {
        when(categoryService.getAllCategories())
                .thenReturn(List.of(new Category(), new Category()));

        mockMvc.perform(get("/api/categories/all"))
                .andExpect(status().isOk())
                .andExpect(jsonPath("$.length()").value(2));
    }

    @Test
    void testGetCategoryById() throws Exception {
        Category cat = new Category();
        cat.setCategoryId(1);
        cat.setCategoryName("Dev");

        when(categoryService.getCategoryById(1)).thenReturn(cat);

        mockMvc.perform(get("/api/categories/search/1"))
                .andExpect(status().isOk())
                .andExpect(jsonPath("$.categoryName").value("Dev"));
    }

    @Test
    void testUpdateCategory() throws Exception {
        Category cat = new Category();
        cat.setCategoryId(1);
        cat.setCategoryName("Updated");

        when(categoryService.updateCategory(eq(1), any(Category.class)))
                .thenReturn(cat);

        mockMvc.perform(put("/api/categories/update/1")
                .contentType("application/json")
                .content(objectMapper.writeValueAsString(cat)))
                .andExpect(status().isOk())
                .andExpect(jsonPath("$.categoryName").value("Updated"));
    }

    @Test
    void testDeleteCategory() throws Exception {
        doNothing().when(categoryService).deleteCategory(1);

        mockMvc.perform(delete("/api/categories/delete/1"))
                .andExpect(status().isOk())
                .andExpect(content().string("Category deleted successfully"));
    }

    @Test
    void testSearchCategory() throws Exception {
        Category cat = new Category();
        cat.setCategoryId(1);
        cat.setCategoryName("Dev");

        when(categoryService.searchByName("dev"))
                .thenReturn(List.of(cat));

        mockMvc.perform(get("/api/categories/search")
                .param("name", "dev"))
                .andExpect(status().isOk())
                .andExpect(jsonPath("$.length()").value(1))
                .andExpect(jsonPath("$[0].categoryName").value("Dev"));
    }

    @Test
    void testGetCategoriesByTask() throws Exception {
        when(categoryService.getCategoriesByTaskId(1))
                .thenReturn(List.of(new Category()));

        mockMvc.perform(get("/api/categories/task/1"))
                .andExpect(status().isOk())
                .andExpect(jsonPath("$.length()").value(1));
    }

    // =====================================================
    // 🔹 NOTIFICATION CONTROLLER TESTS
    // =====================================================

    @Test
    void testCreateNotification() throws Exception {
        Notification notification = new Notification();
        notification.setNotificationId(1);
        notification.setText("Task Created");

        when(notificationService.createNotification(any(Notification.class)))
                .thenReturn(notification);

        mockMvc.perform(post("/api/notifications/create")
                .contentType("application/json")
                .content(objectMapper.writeValueAsString(notification)))
                .andExpect(status().isOk())
                .andExpect(jsonPath("$.text").value("Task Created"));
    }

    @Test
    void testGetAllNotifications() throws Exception {
        when(notificationService.getAllNotifications())
                .thenReturn(List.of(new Notification(), new Notification()));

        mockMvc.perform(get("/api/notifications/all"))
                .andExpect(status().isOk())
                .andExpect(jsonPath("$.length()").value(2));
    }

    @Test
    void testGetNotificationById() throws Exception {
        Notification notification = new Notification();
        notification.setNotificationId(1);
        notification.setText("Test");

        when(notificationService.getNotificationById(1))
                .thenReturn(notification);

        mockMvc.perform(get("/api/notifications/1"))
                .andExpect(status().isOk())
                .andExpect(jsonPath("$.text").value("Test"));
    }

    @Test
    void testUpdateNotification() throws Exception {
        Notification notification = new Notification();
        notification.setNotificationId(1);
        notification.setText("Updated");

        when(notificationService.updateNotification(eq(1), any(Notification.class)))
                .thenReturn(notification);

        mockMvc.perform(put("/api/notifications/update/1")
                .contentType("application/json")
                .content(objectMapper.writeValueAsString(notification)))
                .andExpect(status().isOk())
                .andExpect(jsonPath("$.text").value("Updated"));
    }

    @Test
    void testDeleteNotification() throws Exception {
        doNothing().when(notificationService).deleteNotification(1);

        mockMvc.perform(delete("/api/notifications/delete/1"))
                .andExpect(status().isOk())
                .andExpect(content().string("Notification deleted successfully"));
    }

    @Test
    void testGetNotificationsByUser() throws Exception {
        when(notificationService.getNotificationsByUserId(1))
                .thenReturn(List.of(new Notification()));

        mockMvc.perform(get("/api/notifications/user/1"))
                .andExpect(status().isOk())
                .andExpect(jsonPath("$.length()").value(1));
    }

    @Test
    void testSearchNotifications() throws Exception {
        when(notificationService.searchByText("task"))
                .thenReturn(List.of(new Notification()));

        mockMvc.perform(get("/api/notifications/search")
                .param("text", "task"))
                .andExpect(status().isOk())
                .andExpect(jsonPath("$.length()").value(1));
    }

    @Test
    void testGetLatestNotifications() throws Exception {
        when(notificationService.getLatestNotifications())
                .thenReturn(List.of(new Notification()));

        mockMvc.perform(get("/api/notifications/latest"))
                .andExpect(status().isOk())
                .andExpect(jsonPath("$.length()").value(1));
    }
}