<!DOCTYPE html>
<html xmlns:th="http://www.thymeleaf.org">
<head>
    <title>Tasks</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>

<body class="bg-light">

<div class="container mt-4">

    <h2 class="mb-3 text-center">Task List</h2>

    <!-- 🔍 Search -->
    <form th:if="${!viewOnly}" action="/tasks/search" method="get" class="mb-3 d-flex">
        <input type="text" name="name" class="form-control me-2" placeholder="Search task...">
        <button class="btn btn-dark">Search</button>
    </form>

    <!-- 🔽 Sort Dropdown (UI only, safe) -->
    <form method="get" class="mb-3">
        <select name="sort" class="form-select w-25 d-inline">
            <option value="">Sort By</option>
            <option value="taskID">ID</option>
            <option value="taskName">Name</option>
            <option value="status">Status</option>
            <option value="priority">Priority</option>
        </select>
        <button class="btn btn-dark">Apply</button>
    </form>

    <!-- ➕ Create -->
    <a th:if="${!viewOnly}" href="/tasks/create" class="btn btn-primary mb-3">+ Create Task</a>

    <!-- 🔢 Pagination Logic -->
    <div th:with="
        page=${param.page != null ? T(java.lang.Integer).parseInt(param.page[0]) : 0},
        size=5,
        start=${page * size},
        end=${start + size > tasks.size()} ? ${tasks.size()} : ${start + size},
        pageList=${tasks.subList(start, end)}
    ">

    <table class="table table-bordered table-hover">

        <thead class="table-dark">
        <tr>
            <th>ID</th>
            <th>Name</th>
            <th>Description</th>
            <th>Status</th>
            <th>Priority</th>
			<th>Due Date</th>
            <th th:if="${!viewOnly}">Actions</th>
        </tr>
        </thead>

        <tbody>
        <tr th:each="t : ${pageList}">
            <td th:text="${t.taskID}"></td>
            <td th:text="${t.taskName}"></td>
            <td th:text="${t.description}"></td>
            <td th:text="${t.status}"></td>
            <td th:text="${t.priority}"></td>
			<td th:text="${t.dueDate != null ? #dates.format(t.dueDate, 'dd-MM-yyyy') : 'N/A'}"></td>


            <td th:if="${!viewOnly}">
                <a th:href="@{'/tasks/edit/' + ${t.taskID}}" class="btn btn-warning btn-sm">Edit</a>

                <a th:href="@{'/tasks/delete/' + ${t.taskID}}"
                   class="btn btn-danger btn-sm"
                   onclick="return confirm('Are you sure?')">
                   Delete
                </a>
            </td>
        </tr>
        </tbody>

    </table>

    <!-- 🔢 Pagination Buttons -->
    <div class="d-flex justify-content-center mt-3"
         th:with="totalPages=${(tasks.size() + size - 1) / size}">

        <!-- Previous -->
        <a class="btn btn-secondary me-2"
           th:if="${page > 0}"
           th:href="@{/tasks(page=${page - 1})}">
            Previous
        </a>

        <!-- Page Numbers -->
        <span th:each="i : ${#numbers.sequence(0, totalPages - 1)}">
            <a class="btn btn-outline-primary me-1"
               th:classappend="${i == page} ? 'active'"
               th:href="@{/tasks(page=${i})}"
               th:text="${i + 1}">
            </a>
        </span>

        <!-- Next -->
        <a class="btn btn-secondary ms-2"
           th:if="${page < totalPages - 1}"
           th:href="@{/tasks(page=${page + 1})}">
            Next
        </a>

    </div>

    </div>

</div>

</body>
</html>