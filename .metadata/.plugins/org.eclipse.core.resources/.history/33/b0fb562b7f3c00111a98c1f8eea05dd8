<!DOCTYPE html>
<html xmlns:th="http://www.thymeleaf.org">

<head>
    <title>Login</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
	<style>
	        body {
	            background: linear-gradient(135deg, #0f172a, #1e293b);
	            color: white;
	            font-family: 'Segoe UI', sans-serif;
	        }

	        .box {
	            max-width: 500px;
				max-height: 500px;
	            margin: 40px auto;
	            padding: 30px;
	            border-radius: 15px;
	            background: #1e293b;
	            text-align: center;
	            box-shadow: 0 10px 30px rgba(0,0,0,0.5);
	        }
		</style>
</head>

<body class="box ,d-flex justify-content-center align-items-center vh-100">

<div class="card p-4 shadow" style="width: 350px;">
    <h3 class="text-center mb-3">Login</h3>

    <div th:if="${error}" class="alert alert-danger" th:text="${error}"></div>

    <form th:action="@{/login-action}" method="post">
		<input type="hidden" name="redirect" value="/tasks/task-endpoints">
        <input name="username" id="username" class="form-control mb-2" placeholder="Username" required>
        <input name="password" id="password" type="password" class="form-control mb-3" placeholder="Password" required>
        <button type="submit" class="btn btn-primary w-100">Login</button>
    </form>
</div>

</body>
</html>