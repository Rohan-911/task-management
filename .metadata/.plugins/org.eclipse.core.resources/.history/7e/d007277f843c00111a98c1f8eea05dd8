<!DOCTYPE html>
<html xmlns:th="http://www.thymeleaf.org">
<head>
    <title>Tasks By User</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>

<body class="bg-light">

<div class="container mt-5">
    <div class="card p-4 shadow">

        <h3>Tasks By User</h3>
		<!-- SEARCH TASKS BY USER -->
		<form method="get" th:action="@{/tasks/user}">
		    <div class="input-group mb-3">
		        <input type="text" name="userId" class="form-control" placeholder="Enter User ID">
		        <button class="btn btn-success">Search</button>
		    </div>
		</form>

        <table class="table table-bordered" th:if="${tasks}">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Name</th>
                    <th>Status</th>
                    <th>Priority</th>
                </tr>
            </thead>
            <tbody>
                <tr th:each="t : ${tasks}">
                    <td th:text="${t.taskID}"></td>
                    <td th:text="${t.taskName}"></td>
                    <td th:text="${t.status}"></td>
                    <td th:text="${t.priority}"></td>
                </tr>
            </tbody>
        </table>

        <a href="/task" class="btn btn-secondary mt-3">Back</a>

    </div>
</div>

</body>
</html>