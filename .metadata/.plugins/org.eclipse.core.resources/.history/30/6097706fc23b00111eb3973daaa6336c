<!DOCTYPE html>
<html xmlns:th="http://www.thymeleaf.org">
<head>
    <title>Tasks</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>

<body class="bg-light">

<div class="container mt-4">

    <h2 class="mb-3 text-center">Task List</h2>
	<tr th:each="task, iterStat : ${tasks}"
	    th:if="${iterStat.index >= currentPage * 5 and iterStat.index < (currentPage + 1) * 5}">
	    
	    <td th:text="${task.taskID}"></td>
	    <td th:text="${task.taskName}"></td>
	    <td th:text="${task.projectID}"></td>
	</tr>

    <!-- 🔍 Search -->
    <form th:if="${!viewOnly}" action="/tasks/search" method="get" class="mb-3 d-flex">
        <input type="text" name="name" class="form-control me-2" placeholder="Search task...">
        <button class="btn btn-dark">Search</button>
    </form>

    <!-- ➕ Create -->
    <a th:if="${!viewOnly}" href="/tasks/create" class="btn btn-primary mb-3">+ Create Task</a>

    <table class="table table-bordered table-hover">

        <thead class="table-dark">
        <tr>
            <th>ID</th>
            <th>Name</th>
            <th>Description</th>
            <th>Status</th>
            <th>Priority</th>
            <th th:if="${!viewOnly}">Actions</th>
        </tr>
        </thead>

        <tbody>
        <tr th:each="t : ${tasks}">
            <td th:text="${t.taskID}"></td>
            <td th:text="${t.taskName}"></td>
            <td th:text="${t.description}"></td>
            <td th:text="${t.status}"></td>
            <td th:text="${t.priority}"></td>

            <!-- ✏️ Actions only in full mode -->
            <td th:if="${!viewOnly}">
                <a th:href="@{'/tasks/edit/' + ${t.taskID}}" class="btn btn-warning btn-sm">Edit</a>

                <a th:href="@{'/tasks/delete/' + ${t.taskID}}"
                   class="btn btn-danger btn-sm"
                   onclick="return confirm('Are you sure?')">
                   Delete
                </a>
            </td>
        </tr>
        </tbody>

    </table>

</div>

</body>
</html>