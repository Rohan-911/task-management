<!DOCTYPE html>
<html xmlns:th="http://www.thymeleaf.org">

<head>
    <title>Create Task</title>

    <!-- Bootstrap + Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css" rel="stylesheet">
		<style>

	/* LIGHT MODE */
	body {
	    background: #f5f7fb;
	    color: #111;
	}

	/* DARK MODE */
	body.dark-mode {
	    background: #0f172a;
	    color: #e2e8f0;
	}

	/* CARD */
	body.dark-mode .form-card,
	body.dark-mode .card,
	body.dark-mode .container {
	    background: #1e293b !important;
	    color: #e2e8f0;
	}

	/* LABELS (IMPORTANT FIX) */
	body.dark-mode label {
	    color: #cbd5e1 !important;
	}

	/* INPUTS */
	body.dark-mode input,
	body.dark-mode select,
	body.dark-mode textarea {
	    background: #334155 !important;
	    color: #f1f5f9 !important;
	    border: 1px solid #475569 !important;
	}

	/* PLACEHOLDER */
	body.dark-mode input::placeholder {
	    color: #94a3b8;
	}

	/* BUTTONS */
	body.dark-mode .btn-secondary {
	    background: #475569;
	    border: none;
	}

	body.dark-mode .btn-success {
	    background: #22c55e;
	}

	/* REMOVE ANY FADE EFFECT */
	body.dark-mode * {
	    opacity: 1 !important;
	}

	</style>
    <style>
        body {
            background: linear-gradient(to right, #eef2f7, #f8fafc);
            font-family: 'Segoe UI', sans-serif;
        }

        .form-container {
            max-width: 900px;
            margin: 50px auto;
        }

        .form-card {
            background: white;
            border-radius: 15px;
            padding: 30px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.08);
        }

        .form-title {
            text-align: center;
            font-weight: 700;
            margin-bottom: 25px;
        }

        .form-label {
            font-weight: 500;
        }

        .input-group-text {
            background: #f1f5f9;
        }

        .form-control:focus {
            border-color: #6366f1;
            box-shadow: 0 0 5px rgba(99,102,241,0.3);
        }

        .btn {
            border-radius: 8px;
            padding: 8px 18px;
        }

        .btn-success {
            background: #22c55e;
            border: none;
        }

        .btn-success:hover {
            background: #16a34a;
        }

        .btn-secondary {
            border: none;
        }

        .row-gap {
            margin-bottom: 15px;
        }
    </style>
</head>

<body>
	
<div class="form-container">

    <div class="form-card">

        <h2 class="form-title"> Create Task</h2>

        <form th:action="@{/tasks/create}" th:object="${task}" method="post">

            <div class="row">

                <!-- Task ID -->
                <div class="col-md-6 row-gap">
                    <label class="form-label">Task ID</label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="bi bi-hash"></i></span>
                        <input type="number" th:field="*{taskID}" class="form-control" required>
                    </div>
                </div>

                <!-- Task Name -->
                <div class="col-md-6 row-gap">
                    <label class="form-label">Task Name</label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="bi bi-card-text"></i></span>
                        <input type="text" th:field="*{taskName}" class="form-control" required>
                    </div>
                </div>

            </div>

            <!-- Description -->
            <div class="mb-3">
                <label class="form-label">Description</label>
                <textarea th:field="*{description}" class="form-control" rows="3"></textarea>
            </div>

            <div class="row">

                <!-- Status -->
                <div class="col-md-6 row-gap">
                    <label class="form-label">Status</label>
                    <select th:field="*{status}" class="form-control" required>
                        <option value="Pending">Pending</option>
                        <option value="In Progress">In Progress</option>
                        <option value="Completed">Completed</option>
                    </select>
                </div>

                <!-- Priority -->
                <div class="col-md-6 row-gap">
                    <label class="form-label">Priority</label>
                    <select th:field="*{priority}" class="form-control" required>
                        <option value="Low">Low</option>
                        <option value="Medium">Medium</option>
                        <option value="High">High</option>
                    </select>
                </div>

            </div>

            <div class="row">

                <!-- User ID -->
                <div class="col-md-6 row-gap">
                    <label class="form-label">User ID</label>
                    <input type="number" th:field="*{userID}" class="form-control" required>
                </div>

                <!-- Project ID -->
                <div class="col-md-6 row-gap">
                    <label class="form-label">Project ID</label>
                    <input type="number" th:field="*{projectID}" class="form-control" required>
                </div>

            </div>

            <!-- Due Date -->
            <div class="mb-3">
                <label class="form-label">Due Date</label>
                <input type="date" class="form-control" th:field="*{dueDate}">
            </div>

            <!-- BUTTONS -->
            <div class="d-flex justify-content-between mt-4">
                <a href="/tasks" class="btn btn-secondary"> Back</a>
                <button type="submit" class="btn btn-success"> Save Task</button>
            </div>

        </form>

    </div>

</div>

</body>
</html>