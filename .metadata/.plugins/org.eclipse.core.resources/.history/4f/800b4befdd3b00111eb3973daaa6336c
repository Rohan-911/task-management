<!DOCTYPE html>
<html xmlns:th="http://www.thymeleaf.org">
<head>
    <title>Home - Team</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">

    <style>
        body {
            background-color: #f4f6f9;
            font-family: 'Segoe UI', sans-serif;
        }

        .header {
            text-align: center;
            margin-top: 40px;
        }

        .header h2 {
            font-weight: 700;
        }

        .header p {
            color: gray;
        }

        .card {
            border: none;
            border-radius: 15px;
            overflow: hidden;
            transition: 0.3s;
            cursor: pointer;
        }

        .card:hover {
            transform: translateY(-8px);
            box-shadow: 0 10px 25px rgba(0,0,0,0.1);
        }

        .card img {
            height: 260px;
            object-fit: cover;
        }

        .card-body {
            text-align: center;
        }

        .card-title {
            font-weight: 600;
            margin-bottom: 5px;
        }

        .role {
            font-size: 13px;
            color: gray;
        }

        a {
            text-decoration: none;
            color: black;
        }
    </style>
</head>

<body>

<div class="container">

    <!-- HEADER -->
    <div class="header">
        <h2>Our Modules Team</h2>
        <p>Click on a module to view its APIs</p>
    </div>

    <!-- CARDS -->
    <div class="row mt-5 g-4">

        <!-- USER MODULE -->
        <div class="col-md-4">
            <a th:href="@{/user}">
                <div class="card">
                    <img src="/images/user.jpg" alt="User">
                    <div class="card-body">
                        <h5 class="card-title">User Module</h5>
                        <p class="role">Handles users & authentication</p>
                    </div>
                </div>
            </a>
        </div>

        <!-- TASK MODULE -->
        <div class="col-md-4">
            <a th:href="@{/task}">
                <div class="card">
                    <img src="/images/task.jpg" alt="Task">
                    <div class="card-body">
                        <h5 class="card-title">Task Module</h5>
                        <p class="role">Task management system</p>
                    </div>
                </div>
            </a>
        </div>

        <!-- PROJECT MODULE -->
        <div class="col-md-4">
            <a th:href="@{/project}">
                <div class="card">
                    <img src="/images/project.jpg" alt="Project">
                    <div class="card-body">
                        <h5 class="card-title">Project Module</h5>
                        <p class="role">Project handling & tracking</p>
                    </div>
                </div>
            </a>
        </div>

        <!-- COMMENT MODULE -->
        <div class="col-md-4">
            <a th:href="@{/comment}">
                <div class="card">
                    <img src="/images/comment.jpg" alt="Comment">
                    <div class="card-body">
                        <h5 class="card-title">Comment Module</h5>
                        <p class="role">Task discussions & feedback</p>
                    </div>
                </div>
            </a>
        </div>

        <!-- NOTIFICATION MODULE -->
        <div class="col-md-4">
            <a th:href="@{/notification}">
                <div class="card">
                    <img src="/images/notification.jpg" alt="Notification">
                    <div class="card-body">
                        <h5 class="card-title">Notification Module</h5>
                        <p class="role">Real-time alerts (RabbitMQ)</p>
                    </div>
                </div>
            </a>
        </div>

    </div>

</div>

</body>
</html>