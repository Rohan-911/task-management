<!DOCTYPE html>
<html xmlns:th="http://www.thymeleaf.org">
<head>
    <title>Edit Task</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>

<div class="container mt-4">

    <h2>Edit Task</h2>

    <form th:action="@{/ui/tasks/update}" th:object="${task}" method="post">

        <input type="hidden" th:field="*{taskID}"/>

        <div class="mb-3">
            <label>Task Name</label>
            <input type="text" th:field="*{taskName}" class="form-control"/>
        </div>

        <div class="mb-3">
            <label>Description</label>
            <input type="text" th:field="*{description}" class="form-control"/>
        </div>

        <div class="mb-3">
            <label>Status</label>
            <input type="text" th:field="*{status}" class="form-control"/>
        </div>

        <div class="mb-3">
            <label>Priority</label>
            <input type="text" th:field="*{priority}" class="form-control"/>
        </div>

        <div class="mb-3">
            <label>User ID</label>
            <input type="number" th:field="*{userID}" class="form-control"/>
        </div>

        <div class="mb-3">
            <label>Project ID</label>
            <input type="number" th:field="*{projectID}" class="form-control"/>
        </div>

        <button type="submit" class="btn btn-primary">Update</button>
        <a href="/ui/tasks" class="btn btn-secondary">Back</a>

    </form>

</div>

</body>
</html>