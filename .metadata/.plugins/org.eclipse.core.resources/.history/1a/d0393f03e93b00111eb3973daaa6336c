<!DOCTYPE html>
<html xmlns:th="http://www.thymeleaf.org">

<head>
    <title>Task List</title>

    <!-- Bootstrap -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">

    <style>
        body {
            background: #f5f7fb;
            font-family: 'Segoe UI', sans-serif;
        }

        .container-box {
            max-width: 1100px;
            margin: 40px auto;
        }

        .card-custom {
            background: white;
            border-radius: 12px;
            padding: 20px;
            box-shadow: 0 5px 20px rgba(0,0,0,0.08);
        }

        .page-title {
            text-align: center;
            font-weight: 700;
            margin-bottom: 25px;
        }

        .search-row {
            display: flex;
            gap: 10px;
            margin-bottom: 15px;
        }

        .search-row input {
            flex: 1;
            border-radius: 8px;
            padding: 10px;
            border: 1px solid #ddd;
        }

        .table thead {
            background: #1f2937;
            color: white;
        }

        .btn-edit {
            background: #facc15;
            border: none;
            padding: 5px 10px;
            border-radius: 6px;
        }

        .btn-delete {
            background: #ef4444;
            color: white;
            border: none;
            padding: 5px 10px;
            border-radius: 6px;
        }
    </style>
</head>

<body>

<div class="container-box">

    <div class="card-custom">

        <!-- TITLE -->
        <h2 class="page-title">Task List</h2>

        <!-- SEARCH -->
        <form th:if="${!viewOnly}" action="/tasks/search" method="get" class="search-row">
            <input type="text" name="name" placeholder="Search task...">
            <button class="btn btn-dark">Search</button>
        </form>

        <!-- CREATE -->
        <a th:if="${!viewOnly}" href="/tasks/create" class="btn btn-primary mb-3">
            + Create Task
        </a>

        <!-- PAGINATION LOGIC -->
        <div th:with="
            page=${param.page != null ? T(java.lang.Integer).parseInt(param.page[0]) : 0},
            size=5,
            start=${page * size},
            end=${start + size > tasks.size()} ? ${tasks.size()} : ${start + size},
            pageList=${tasks.subList(start, end)}
        ">

        <!-- TABLE -->
        <div class="table-responsive">
            <table class="table table-bordered table-hover align-middle">

                <thead>
                <tr>
                    <th>ID</th>
                    <th>Name</th>
                    <th>Description</th>
                    <th>Status</th>
                    <th>Priority</th>
                    <th>Due Date</th>
                    <th th:if="${!viewOnly}">Actions</th>
                </tr>
                </thead>

                <tbody>
                <tr th:each="t : ${pageList}">
                    <td th:text="${t.taskID}"></td>
                    <td th:text="${t.taskName}"></td>
                    <td th:text="${t.description}"></td>
                    <td th:text="${t.status}"></td>
                    <td th:text="${t.priority}"></td>
                    <td th:text="${t.dueDate != null ? #dates.format(t.dueDate, 'dd-MM-yyyy') : 'N/A'}"></td>

                    <td th:if="${!viewOnly}">
                        <a th:href="@{'/tasks/edit/' + ${t.taskID}}" class="btn-edit me-1">Edit</a>
                        <a th:href="@{'/tasks/delete/' + ${t.taskID}}"
                           class="btn-delete"
                           onclick="return confirm('Are you sure?')">
                           Delete
                        </a>
                    </td>
                </tr>
                </tbody>

            </table>
        </div>

        <!-- PAGINATION -->
        <div class="d-flex justify-content-center mt-3"
             th:with="totalPages=${(tasks.size() + size - 1) / size}">

            <a class="btn btn-secondary me-2"
               th:if="${page > 0}"
               th:href="@{/tasks(page=${page - 1})}">
                Previous
            </a>

            <span th:each="i : ${#numbers.sequence(0, totalPages - 1)}">
                <a class="btn btn-outline-primary me-1"
                   th:classappend="${i == page} ? 'active'"
                   th:href="@{/tasks(page=${i})}"
                   th:text="${i + 1}">
                </a>
            </span>

            <a class="btn btn-secondary ms-2"
               th:if="${page < totalPages - 1}"
               th:href="@{/tasks(page=${page + 1})}">
                Next
            </a>

        </div>

        </div>

    </div>

</div>

</body>
</html>