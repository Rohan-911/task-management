<!DOCTYPE html>
<html xmlns:th="http://www.thymeleaf.org">

<head>
    <title>Task Dashboard</title>

    <!-- Bootstrap + Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css" rel="stylesheet">

    <!-- Font -->
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600&display=swap" rel="stylesheet">

    <style>
        * { font-family: 'Poppins', sans-serif; }

        body {
            margin: 0;
            background: linear-gradient(135deg, #eef2f7, #f8fafc);
        }

        /* SIDEBAR */
        .sidebar {
            width: 260px;
            height: 100vh;
            position: fixed;
            background: linear-gradient(180deg, #0f172a, #1e293b);
            color: white;
            padding: 25px;
            box-shadow: 4px 0 20px rgba(0,0,0,0.1);
        }

        .sidebar h3 {
            margin-bottom: 30px;
            font-weight: 600;
        }

        .sidebar a {
            display: flex;
            align-items: center;
            gap: 10px;
            color: #cbd5e1;
            text-decoration: none;
            padding: 12px;
            border-radius: 12px;
            margin-bottom: 10px;
            transition: 0.3s;
        }

        .sidebar a:hover {
            background: rgba(255,255,255,0.1);
            color: #fff;
            transform: translateX(5px);
        }

        /* TOPBAR */
        .topbar {
            height: 70px;
            background: white;
            margin-left: 260px;
            padding: 15px 25px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            box-shadow: 0 4px 20px rgba(0,0,0,0.05);
        }

        .topbar input {
            border-radius: 25px;
            padding: 6px 15px;
            border: 1px solid #ddd;
            width: 250px;
        }

        /* MAIN */
        .main-content {
            margin-left: 260px;
            padding: 25px;
        }

        /* CARD STYLE */
        .glass-card {
            background: white;
            border-radius: 15px;
            padding: 25px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.05);
        }

        /* TABLE */
        .table thead {
            background: #1e293b;
            color: white;
        }

        .table-hover tbody tr:hover {
            background: #f1f5f9;
        }

        /* BADGES */
        .badge {
            padding: 6px 10px;
            border-radius: 10px;
        }
    </style>

</head>

<body>

    <!-- SIDEBAR -->
    <div class="sidebar">
        <h3><i class="bi bi-kanban"></i> TaskUI</h3>

        <a th:href="@{/tasks}"><i class="bi bi-list-task"></i> Tasks</a>
        <a th:href="@{/tasks/create}"><i class="bi bi-plus-circle"></i> Create</a>
        <a th:href="@{/dashboard}"><i class="bi bi-speedometer2"></i> Dashboard</a>
        <a th:href="@{/logout}"><i class="bi bi-box-arrow-right"></i> Logout</a>
    </div>

    <!-- TOPBAR -->
    <div class="topbar">
        <input type="text" placeholder="Search...">
        <div>
            <i class="bi bi-bell me-3"></i>
            <i class="bi bi-person-circle"></i>
        </div>
    </div>

    <!-- MAIN -->
	<div th:fragment="content">
	    <!-- content will come here -->
	</div>

</body>
</html>