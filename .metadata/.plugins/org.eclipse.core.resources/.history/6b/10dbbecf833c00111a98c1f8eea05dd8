<!DOCTYPE html>
<html xmlns:th="http://www.thymeleaf.org">
<head>
    <title>Task By ID</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>

<body class="bg-light">

<div class="container mt-5">
    <div class="card p-4 shadow">

        <h3>Task Details</h3>
		<!-- SEARCH TASK BY ID -->
		<form method="get" th:action="@{/tasks/id}">
		    <div class="input-group mb-3">
		        <input type="text" name="id" class="form-control" placeholder="Enter Task ID">
		        <button class="btn btn-primary">Search</button>
		    </div>
		</form>

        <!-- RESULT -->
        <div th:if="${task != null}">
            <p><b>ID:</b> <span th:text="${task.taskID}"></span></p>
            <p><b>Name:</b> <span th:text="${task.taskName}"></span></p>
            <p><b>Description:</b> <span th:text="${task.description}"></span></p>
            <p><b>Status:</b> <span th:text="${task.status}"></span></p>
            <p><b>Priority:</b> <span th:text="${task.priority}"></span></p>
        </div>

        <!-- IF NOT FOUND -->
        <div th:if="${task == null}">
            <p class="text-danger">Task not found</p>
        </div>

        <a href="/task" class="btn btn-secondary mt-3">Back</a>

    </div>
</div>

</body>
</html>