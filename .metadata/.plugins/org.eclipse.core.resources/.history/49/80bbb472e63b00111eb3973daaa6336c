<!DOCTYPE html>
<html xmlns:th="http://www.thymeleaf.org"
      th:replace="~{taskservice/layout :: layout (~{::body})}">

<body>

<style>
    .dashboard-title {
        text-align: center;
        font-weight: 700;
        color: #6c63ff;
        margin-bottom: 20px;
    }

    .status-pill {
        padding: 6px 14px;
        border-radius: 20px;
        font-weight: 600;
        font-size: 13px;
    }

    .admin-pill {
        background: #ef4444;
        color: white;
    }

    .auth-pill {
        color: green;
        font-weight: 600;
    }

    .table-card {
        border-radius: 15px;
        overflow: hidden;
        box-shadow: 0 10px 25px rgba(0,0,0,0.1);
    }

    .table thead {
        background: linear-gradient(to right, #1e293b, #334155);
        color: white;
    }

    .method-badge {
        padding: 5px 12px;
        border-radius: 10px;
        font-weight: 600;
        font-size: 12px;
    }

    .get { background: #dbeafe; color: #1d4ed8; }
    .post { background: #d1fae5; color: #065f46; }
    .put { background: #fef3c7; color: #92400e; }
    .delete { background: #fee2e2; color: #991b1b; }

    .action-btn {
        border-radius: 10px;
        padding: 6px 14px;
        font-weight: 500;
        border: none;
    }

    .btn-view { background: #3b82f6; color: white; }
    .btn-edit { background: #f59e0b; color: white; }
    .btn-delete { background: #ef4444; color: white; }
</style>

<!-- HEADER -->
<div class="text-center mb-4">
    <h2 class="dashboard-title">Task Dashboard</h2>

    <span class="status-pill admin-pill">ADMIN</span>
    <span class="auth-pill ms-2">Authenticated ✔</span>

    <a href="/logout" class="btn btn-danger btn-sm ms-3">Logout</a>
</div>

<!-- TASK TABLE -->
<div class="table-card p-3 bg-white">

    <h5 class="mb-3">
        <i class="bi bi-list-task"></i> Task Management
    </h5>

    <div class="table-responsive">
        <table class="table align-middle">

            <thead>
            <tr>
                <th>ID</th>
                <th>Task</th>
                <th>Description</th>
                <th>Status</th>
                <th>Priority</th>
                <th>Due Date</th>
                <th>Action</th>
            </tr>
            </thead>

            <tbody>
            <tr th:each="t : ${tasks}">

                <td th:text="${t.taskID}"></td>

                <td th:text="${t.taskName}"></td>

                <td th:text="${t.description}"></td>

                <td>
                    <span class="method-badge"
                          th:classappend="
                          ${t.status == 'Completed'} ? ' get' :
                          (${t.status == 'Pending'} ? ' post' : ' put')"
                          th:text="${t.status}">
                    </span>
                </td>

                <td th:text="${t.priority}"></td>

                <td th:text="${t.dueDate != null ? #dates.format(t.dueDate, 'dd-MM-yyyy') : 'N/A'}"></td>

                <td>
                    <a th:href="@{'/tasks/edit/' + ${t.taskID}}"
                       class="action-btn btn-edit me-1">Edit</a>

                    <a th:href="@{'/tasks/delete/' + ${t.taskID}}"
                       class="action-btn btn-delete"
                       onclick="return confirm('Are you sure?')">Delete</a>
                </td>

            </tr>
            </tbody>

        </table>
    </div>

</div>

</body>
</html>