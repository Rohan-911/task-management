<!DOCTYPE html>
<html>
<head>
    <title>Redirecting...</title>
</head>
<body>
    <p style="text-align:center; margin-top:50px; color:#64748b;">Redirecting...</p>

    <script>
        // Auto-redirect to the correct dashboard based on stored roles
        const roles = JSON.parse(localStorage.getItem("roles") || "[]");

        if (roles.map(r => r.toUpperCase()).includes("ADMIN")) {
            window.location.href = "/admin-dashboard";
        } else if (roles.length > 0) {
            window.location.href = "/user-dashboard";
        } else {
            // No roles stored — send back to login
            window.location.href = "/";
        }
    </script>
</body>
</html>