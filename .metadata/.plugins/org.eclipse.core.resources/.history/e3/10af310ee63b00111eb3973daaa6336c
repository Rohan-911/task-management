<!DOCTYPE html>
<html xmlns:th="http://www.thymeleaf.org"
      th:replace="~{taskservice/layout :: layout (~{::body})}">

<body>

<div class="card p-4">

    <h2 class="mb-3 page-title">Task List</h2>

    <!-- Search -->
    <form action="/tasks/search" method="get" class="mb-3 d-flex">
        <input type="text" name="name" class="form-control me-2" placeholder="Search task...">
        <button class="btn btn-dark">Search</button>
    </form>

    <!-- Create -->
    <a href="/tasks/create" class="btn btn-primary mb-3">+ Create Task</a>

    <!-- Table -->
    <div class="table-responsive">
        <table class="table table-hover align-middle">

            <thead>
            <tr>
                <th>ID</th>
                <th>Name</th>
                <th>Description</th>
                <th>Status</th>
                <th>Priority</th>
                <th>Due Date</th>
            </tr>
            </thead>

            <tbody>
            <tr th:each="t : ${tasks}">
                <td th:text="${t.taskID}"></td>
                <td th:text="${t.taskName}"></td>
                <td th:text="${t.description}"></td>

                <td>
                    <span class="badge"
                          th:classappend="
                          ${t.status == 'Completed'} ? ' bg-success' :
                          (${t.status == 'Pending'} ? ' bg-warning text-dark' : ' bg-primary')"
                          th:text="${t.status}">
                    </span>
                </td>

                <td th:text="${t.priority}"></td>

                <td th:text="${t.dueDate != null ? #dates.format(t.dueDate, 'dd-MM-yyyy') : 'N/A'}"></td>
            </tr>
            </tbody>

        </table>
    </div>

</div>

</body>
</html>