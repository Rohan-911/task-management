<!DOCTYPE html>
<html xmlns:th="http://www.thymeleaf.org">

<head>
    <title>Tasks</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">

    <style>
        body {
            background: linear-gradient(135deg, #0f172a, #1e293b);
            font-family: 'Segoe UI', sans-serif;
            color: white;
        }

        .container-box {
            max-width: 1300px;
			max-height: 1300px;
            margin: 40px auto;
            background: #1e293b;
            padding: 25px;
            border-radius: 15px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.5);
        }

        h2 {
            text-align: center;
            margin-bottom: 20px;
        }

        /* Search */
        .form-control {
            background: #334155;
            border: none;
            color: white;
        }

        .form-control::placeholder {
            color: #cbd5e1;
        }

        /* Table */
        .table {
            background: white;
            border-radius: 10px;
            overflow: hidden;
        }

        .table thead {
            background: #1f2937;
            color: white;
        }

        .table tbody tr:hover {
            background: #f1f5f9;
            transition: 0.2s;
        }

        /* Status badges */
        .status {
            padding: 5px 10px;
            border-radius: 20px;
            font-size: 12px;
            font-weight: 500;
        }

        .pending {
            background: #d1fae5;
            color: #065f46;
        }

        .progress {
            background: #fef3c7;
            color: #92400e;
        }

        .completed {
            background: #bfdbfe;
            color: #1e3a8a;
        }

        /* Buttons */
        .btn-warning {
            background: #facc15;
            border: none;
        }

        .btn-danger {
            background: #ef4444;
            border: none;
        }

        .btn-primary {
            background: #2563eb;
            border: none;
        }
    </style>
</head>

<body>

<div class="container-box">

    <h2>Task List</h2>

    <!-- 🔍 Search -->
    <form th:if="${!viewOnly}" action="/tasks/search" method="get" class="mb-3 d-flex">
        <input type="text" name="name" class="form-control me-2" placeholder="Search task...">
        <button class="btn btn-dark">Search</button>
    </form>

    <!-- ➕ Create -->
    <a th:if="${!viewOnly}" href="/tasks/create" class="btn btn-primary mb-3">
        + Create Task
    </a>

    <!-- Pagination Logic -->
    <div th:with="
        page=${param.page != null ? T(java.lang.Integer).parseInt(param.page[0]) : 0},
        size=5,
        start=${page * size},
        end=${start + size > tasks.size()} ? ${tasks.size()} : ${start + size},
        pageList=${tasks.subList(start, end)}
    ">

        <table class="table table-hover">

            <thead>
            <tr>
                <th>ID</th>
                <th>Name</th>
                <th>Description</th>
                <th>Status</th>
                <th>Priority</th>
                <th>Due Date</th>
                <th th:if="${!viewOnly}">Actions</th>
            </tr>
            </thead>

            <tbody>
            <tr th:each="t : ${pageList}">

                <td th:text="${t.taskID}"></td>
                <td th:text="${t.taskName}"></td>
                <td th:text="${t.description}"></td>

                <!-- STATUS WITH COLOR -->
                <td>
                    <span th:text="${t.status}"
                          th:classappend="
                            ${t.status == 'Pending'} ? 'status pending' :
                            (${t.status == 'In Progress'} ? 'status progress' :
                            'status completed')
                          ">
                    </span>
                </td>

                <td th:text="${t.priority}"></td>

                <td th:text="${t.dueDate != null ? #dates.format(t.dueDate, 'dd-MM-yyyy') : 'N/A'}"></td>

                <td th:if="${!viewOnly}">
                    <a th:href="@{'/tasks/edit/' + ${t.taskID}}" class="btn btn-warning btn-sm">Edit</a>
                    <a th:href="@{'/tasks/delete/' + ${t.taskID}}"
                       class="btn btn-danger btn-sm"
                       onclick="return confirm('Are you sure?')">
                        Delete
                    </a>
                </td>

            </tr>
            </tbody>

        </table>

        <!-- 🔢 Pagination -->
        <div class="d-flex justify-content-center mt-3"
             th:with="totalPages=${(tasks.size() + size - 1) / size}">

            <a class="btn btn-secondary me-2"
               th:if="${page > 0}"
               th:href="@{/tasks(page=${page - 1})}">
                Previous
            </a>

            <span th:each="i : ${#numbers.sequence(0, totalPages - 1)}">
                <a class="btn btn-outline-light me-1"
                   th:classappend="${i == page} ? 'active'"
                   th:href="@{/tasks(page=${i})}"
                   th:text="${i + 1}">
                </a>
            </span>

            <a class="btn btn-secondary ms-2"
               th:if="${page < totalPages - 1}"
               th:href="@{/tasks(page=${page + 1})}">
                Next
            </a>

        </div>

    </div>

</div>

</body>
</html>