<!DOCTYPE html>
<html xmlns:th="http://www.thymeleaf.org"
      th:replace="~{layout :: layout(~{::content})}">

<div th:fragment="content">

    <!-- HEADER -->
    <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:30px;">
        <div>
            <h2 style="font-weight:700; color:#1e293b; margin:0;">
                <span style="background:linear-gradient(135deg,#6366f1,#8b5cf6);
                             -webkit-background-clip:text; -webkit-text-fill-color:transparent;">
                    Users Directory
                </span>
            </h2>
            <p style="color:#64748b; margin-top:5px; margin-bottom:0;">View and manage system users</p>
        </div>

        <a href="/create-user"
           class="admin-only create-btn"
           style="display:none;">
            + Create New User
        </a>
    </div>

    <!-- SUCCESS MESSAGE -->
    <div th:if="${success}" style="background:#dcfce7; color:#15803d; padding:12px 20px; border-radius:8px; margin-bottom:20px; border-left:4px solid #22c55e;">
        <span th:text="${success}"></span>
    </div>

    <!-- TABLE -->
    <div style="background:white; border-radius:12px;
                box-shadow:0 10px 25px -5px rgba(0,0,0,0.05); overflow:visible;">

        <table style="width:100%; text-align:left; border-collapse:collapse;">

            <thead>
                <tr style="background:linear-gradient(135deg,#f8fafc,#f1f5f9); border-bottom:2px solid #e2e8f0;">
                    <th style="padding:16px 20px; color:#475569; font-weight:600; border-top-left-radius: 12px;">ID</th>
                    <th style="padding:16px 20px; color:#475569; font-weight:600;">User Details</th>
                    
                    <!-- USER ONLY: Roles -->
                    <th class="user-only" style="padding:16px 20px; color:#475569; font-weight:600;">Roles</th>

                    <!-- ADMIN ONLY: Assign Roles & Actions -->
                    <th class="admin-only" style="display:none; padding:16px 20px; color:#475569; font-weight:600; text-align:center;">Manage Roles</th>
                    <th class="admin-only" style="display:none; padding:16px 20px; color:#475569; font-weight:600; text-align:center; border-top-right-radius: 12px;">Actions</th>
                </tr>
            </thead>

            <tbody>
                <tr th:each="u : ${users}" class="user-row">

                    <td style="padding:16px 20px; font-weight:600; color:#64748b;" th:text="${'#' + u.userId}"></td>
                    
                    <td style="padding:16px 20px;">
                        <div style="font-weight:600; color:#1e293b; font-size:15px;" th:text="${u.username}"></div>
                        <div style="color:#64748b; font-size:13px; margin-top:2px;" th:text="${u.email}"></div>
                    </td>

                    <!-- USER ONLY: Roles Text -->
                    <td class="user-only" style="padding:16px 20px;">
                        <div style="display:flex; gap:6px; flex-wrap:wrap;">
                            <span th:each="role : ${u.roles}"
                                  style="background:#e0f2fe; color:#0284c7; padding:4px 10px;
                                         border-radius:20px; font-size:12px; font-weight:600; letter-spacing:0.5px;"
                                  th:text="${role}"></span>
                        </div>
                    </td>

                    <!-- ADMIN ONLY: Assign Roles Form -->
                    <td class="admin-only" style="display:none; padding:16px 20px; text-align:center;">
                        <div class="dropdown-container">
                            <button type="button" class="btn-dropdown" onclick="toggleDropdown(this)">
                                Edit Roles ▾
                            </button>
                            <div class="dropdown-menu-custom">
                                <form th:action="@{'/assign-roles/' + ${u.userId}}" method="post">
                                    <div style="max-height: 150px; overflow-y: auto; text-align: left; margin-bottom: 12px; padding-right: 5px;">
                                        <label th:each="role : ${allRoles}" class="dropdown-item-custom">
                                            <input type="checkbox" name="roles"
                                                   th:value="${role}"
                                                   th:checked="${u.roles.contains(role)}"
                                                   class="custom-checkbox">
                                            <span th:text="${role}"></span>
                                        </label>
                                    </div>
                                    <button type="submit" class="btn-update" style="width: 100%;">Save Changes</button>
                                </form>
                            </div>
                        </div>
                    </td>

                    <!-- ADMIN ONLY: Actions -->
                    <td class="admin-only" style="display:none; padding:16px 20px; text-align:center;">
                        <div style="display:flex; gap:8px; justify-content:center;">
                            <a th:href="@{'/update-user/' + ${u.userId}}" class="btn-icon btn-edit" title="Edit User">
                                ✏️ Edit
                            </a>

                            <form th:action="@{'/delete-user/' + ${u.userId}}" method="post" style="margin:0;"
                                  onsubmit="return confirm('Are you sure you want to delete this user?');">
                                <button type="submit" class="btn-icon btn-delete" title="Delete User">
                                    🗑️ Delete
                                </button>
                            </form>
                        </div>
                    </td>

                </tr>
            </tbody>

        </table>
    </div>

    <!-- PAGINATION -->
    <div th:if="${totalPages > 1}" style="display:flex; justify-content:space-between; align-items:center; margin-top:20px; padding:10px 0;">
        <div style="color:#64748b; font-size:14px; font-weight:500;">
            Showing page <b th:text="${currentPage + 1}"></b> of <b th:text="${totalPages}"></b>
        </div>
        <div style="display:flex; gap:10px;">
            <a th:if="${currentPage > 0}" th:href="@{'/users-view?page=' + ${currentPage - 1}}" 
               style="padding:8px 16px; background:white; border:1px solid #cbd5e1; border-radius:6px; color:#475569; text-decoration:none; font-size:14px; font-weight:600; box-shadow:0 1px 2px rgba(0,0,0,0.05); transition:all 0.2s;"
               onmouseover="this.style.background='#f8fafc';" onmouseout="this.style.background='white';">
                Previous
            </a>
            
            <a th:if="${currentPage < totalPages - 1}" th:href="@{'/users-view?page=' + ${currentPage + 1}}" 
               style="padding:8px 16px; background:white; border:1px solid #cbd5e1; border-radius:6px; color:#475569; text-decoration:none; font-size:14px; font-weight:600; box-shadow:0 1px 2px rgba(0,0,0,0.05); transition:all 0.2s;"
               onmouseover="this.style.background='#f8fafc';" onmouseout="this.style.background='white';">
                Next
            </a>
        </div>
    </div>

<style>
/* === TABLE ROWS === */
.user-row {
    border-bottom: 1px solid #f1f5f9;
    transition: background 0.2s, transform 0.15s;
}
.user-row:last-child {
    border-bottom: none;
}
.user-row:hover {
    background: #f8fafc;
}

/* === BUTTONS === */
.create-btn {
    background: linear-gradient(135deg, #16a34a, #22c55e);
    color: white;
    padding: 10px 20px;
    border-radius: 8px;
    text-decoration: none;
    font-weight: 600;
    transition: transform 0.2s, box-shadow 0.2s;
    display: inline-block;
}
.create-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 4px 12px rgba(22, 163, 74, 0.3);
    color: white;
}

.btn-update {
    background: #f1f5f9;
    color: #475569;
    border: 1px solid #cbd5e1;
    padding: 4px 12px;
    border-radius: 6px;
    font-size: 12px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s;
}
.btn-update:hover {
    background: #6366f1;
    color: white;
    border-color: #6366f1;
}

.btn-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 6px 12px;
    border-radius: 6px;
    font-size: 13px;
    font-weight: 500;
    text-decoration: none;
    border: none;
    cursor: pointer;
    transition: all 0.2s;
}
.btn-edit {
    background: #fef3c7;
    color: #d97706;
}
.btn-edit:hover {
    background: #f59e0b;
    color: white;
}
.btn-delete {
    background: #fee2e2;
    color: #dc2626;
}
.btn-delete:hover {
    background: #ef4444;
    color: white;
}

/* === CUSTOM DROPDOWN === */
.dropdown-container {
    position: relative;
    display: inline-block;
}

.btn-dropdown {
    background: white;
    border: 1px solid #cbd5e1;
    color: #475569;
    padding: 6px 14px;
    border-radius: 8px;
    font-size: 13px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s;
    box-shadow: 0 1px 2px rgba(0,0,0,0.05);
}
.btn-dropdown:hover {
    background: #f8fafc;
    border-color: #94a3b8;
    color: #1e293b;
}

.dropdown-menu-custom {
    display: none;
    position: absolute;
    top: 100%;
    left: 50%;
    transform: translateX(-50%);
    margin-top: 8px;
    background: white;
    min-width: 180px;
    box-shadow: 0 10px 25px rgba(0,0,0,0.15);
    border-radius: 10px;
    padding: 12px;
    z-index: 100;
    border: 1px solid #e2e8f0;
}
.dropdown-container.active .dropdown-menu-custom {
    display: block;
    animation: fadeIn 0.2s ease-out;
}

@keyframes fadeIn {
    from { opacity: 0; transform: translate(-50%, -5px); }
    to { opacity: 1; transform: translate(-50%, 0); }
}

.dropdown-item-custom {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 8px 10px;
    cursor: pointer;
    border-radius: 6px;
    transition: background 0.2s;
    font-size: 13px;
    color: #334155;
    font-weight: 500;
    margin-bottom: 2px;
}
.dropdown-item-custom:hover {
    background: #f1f5f9;
}
.custom-checkbox {
    width: 16px;
    height: 16px;
    cursor: pointer;
    accent-color: #6366f1;
}
</style>

<script>
    // Dropdown toggle logic
    function toggleDropdown(btn) {
        document.querySelectorAll('.dropdown-container.active').forEach(container => {
            if (container !== btn.parentElement) {
                container.classList.remove('active');
            }
        });
        btn.parentElement.classList.toggle('active');
    }

    // Close dropdown on outside click
    document.addEventListener('click', function(event) {
        if (!event.target.closest('.dropdown-container')) {
            document.querySelectorAll('.dropdown-container.active').forEach(container => {
                container.classList.remove('active');
            });
        }
    });

    // Toggle Admin/User specific views
    document.addEventListener("DOMContentLoaded", function() {
        try {
            const rolesRaw = localStorage.getItem("roles");
            let roles = [];
            if (rolesRaw && rolesRaw !== "undefined" && rolesRaw !== "null") {
                roles = JSON.parse(rolesRaw);
            }
            
            // Ensure roles is an array
            if (!Array.isArray(roles)) {
                if (typeof roles === 'string') roles = [roles];
                else roles = [];
            }
            
            console.log("Detected roles:", roles);

            const isAdmin = roles.some(r => r && typeof r === 'string' && r.toUpperCase().includes("ADMIN"));

            // Debug element to show current view mode
            const debugHeader = document.createElement('div');
            debugHeader.style.padding = '10px';
            debugHeader.style.textAlign = 'center';
            debugHeader.style.marginBottom = '20px';
            debugHeader.style.borderRadius = '8px';
            
            if (isAdmin) {
                debugHeader.style.background = '#dbeafe';
                debugHeader.style.color = '#1e40af';
                debugHeader.innerHTML = '<strong>Viewing as: ADMIN</strong>. You have full edit/delete access.';
                
                document.querySelectorAll('.admin-only').forEach(el => {
                    // Restore display type based on element
                    if(el.tagName.toLowerCase() === 'td' || el.tagName.toLowerCase() === 'th') {
                        el.style.display = 'table-cell';
                    } else if(el.tagName.toLowerCase() === 'a') {
                        el.style.display = 'inline-block';
                    } else {
                        el.style.display = 'block';
                    }
                });
                document.querySelectorAll('.user-only').forEach(el => {
                    el.style.display = 'none';
                });
            } else {
                debugHeader.style.background = '#fef3c7';
                debugHeader.style.color = '#92400e';
                debugHeader.innerHTML = `<strong>Viewing as: USER</strong>. Roles found in browser: [${roles.join(', ')}]. Actions are hidden.`;
            }
            
            document.querySelector('.content-container').insertBefore(debugHeader, document.querySelector('.content-container').firstChild);

        } catch (e) {
            console.error("Error evaluating roles:", e);
        }
    });
</script>

</div>
</html>