<!DOCTYPE html>
<html xmlns:th="http://www.thymeleaf.org">
<head>
    <title>Search Task</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>

<body class="bg-light">

<div class="container mt-5">
    <div class="card p-4 shadow">

        <h3 class="mb-3">Search Task by Name</h3>

        <form th:action="@{/tasks/search}" method="get">
            <div class="mb-3">
                <input type="text" name="name" class="form-control" placeholder="Enter task name" required>
            </div>

            <button type="submit" class="btn btn-primary">Search</button>
        </form>

        <hr/>

        <!-- Results -->
        <table class="table table-bordered mt-3" th:if="${tasks}">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Name</th>
                    <th>Status</th>
                    <th>Priority</th>
                </tr>
            </thead>
            <tbody>
                <tr th:each="t : ${tasks}">
                    <td th:text="${t.taskID}"></td>
                    <td th:text="${t.taskName}"></td>
                    <td th:text="${t.status}"></td>
                    <td th:text="${t.priority}"></td>
                </tr>
            </tbody>
        </table>

    </div>
</div>

</body>
</html>