<!DOCTYPE html>
<html xmlns:th="http://www.thymeleaf.org"
      th:replace="~{layout :: layout(~{::content})}">

<div th:fragment="content">

    <div style="max-width:500px; margin:auto;">

        <h3 style="text-align:center; color:#1e293b; font-weight:700;">Delete User By ID</h3>

        <div th:if="${success}" style="background:#dcfce7; color:#15803d; padding:12px 20px; border-radius:8px; margin-top:20px; border-left:4px solid #22c55e;">
            <span th:text="${success}"></span>
        </div>
        
        <div th:if="${error}" style="background:#fee2e2; color:#b91c1c; padding:12px 20px; border-radius:8px; margin-top:20px; border-left:4px solid #ef4444;">
            <span th:text="${error}"></span>
        </div>

        <form action="/delete-user-action" method="post"
              style="margin-top:20px; background:white; padding:25px; border-radius:10px; box-shadow:0 4px 6px rgba(0,0,0,0.05);"
              onsubmit="return confirm('WARNING: Are you absolutely sure you want to delete this user?');">

            <div style="margin-bottom:20px;">
                <label style="color:#475569; font-weight:600; font-size:14px; margin-bottom:5px; display:block;">Enter User ID to Delete</label>
                <div style="display:flex; gap:10px;">
                    <input id="userIdInput" name="id" type="number" required placeholder="e.g. 1"
                           th:value="${user != null ? user.userId : ''}"
                           th:readonly="${user != null}"
                           style="flex:1; padding:10px; border-radius:6px; border:1px solid #cbd5e1; font-size:15px;"
                           th:styleappend="${user != null ? 'background:#f1f5f9; color:#64748b;' : ''}">
                           
                    <button type="button" th:if="${user == null}"
                            onclick="var id = document.getElementById('userIdInput').value; if(id) window.location.href='/delete-user-by-id/' + id;"
                            style="background:#f1f5f9; border:1px solid #cbd5e1; padding:10px 15px; border-radius:6px; cursor:pointer; font-weight:600; color:#475569; white-space:nowrap; transition:all 0.2s;"
                            onmouseover="this.style.background='#e2e8f0';" onmouseout="this.style.background='#f1f5f9';">
                        Fetch User
                    </button>
                    
                    <a th:if="${user != null}" href="/delete-user-by-id"
                       style="background:#f1f5f9; border:1px solid #cbd5e1; padding:10px 15px; border-radius:6px; cursor:pointer; font-weight:600; color:#475569; text-decoration:none; white-space:nowrap; display:flex; align-items:center;">
                        Clear
                    </a>
                </div>
            </div>

            <div th:if="${user != null}" style="background:#fef2f2; border:1px solid #fca5a5; padding:15px; border-radius:8px; margin-bottom:20px;">
                <p style="color:#b91c1c; margin:0 0 10px 0; font-weight:600; font-size:14px;">⚠️ Warning: You are about to delete:</p>
                <p style="margin:0; color:#7f1d1d; font-size:15px;">
                    <b th:text="${user.fullName}"></b> (@<span th:text="${user.username}"></span>)
                </p>
                <p style="margin:5px 0 0 0; color:#7f1d1d; font-size:14px;" th:text="${user.email}"></p>
            </div>

            <button type="submit" style="width:100%; background:linear-gradient(135deg,#ef4444,#b91c1c); color:white;
                           padding:12px; border:none; border-radius:6px; cursor:pointer; font-weight:600; font-size:15px;">
                🗑️ Permanently Delete User
            </button>
        </form>

    </div>

</div>
</html>
